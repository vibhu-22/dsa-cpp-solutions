/*
Problem: Two Sum II - Input Array Is Sorted
Platform: LeetCode
Difficulty: Medium
Link: https://leetcode.com/problems/two-sum-ii-input-array-is-sorted/

Approach:
Use two pointers.
Start one pointer from the beginning and another from the end.

If the sum of both numbers is smaller than the target,
move the left pointer forward.

If the sum is greater than the target,
move the right pointer backward.

If the sum equals the target, return both indices.

Time Complexity: O(n)
Space Complexity: O(1)

Mistake I Made:
I did not read the indexing requirement properly.
The question uses 1-based indexing, while C++ vectors use
0-based indexing.

Therefore, I must return i + 1 and j + 1 instead of i and j.

Important Tip:
Always check whether the question uses 0-based or 1-based indexing.
Also, this two-pointer approach works because the array is sorted.
*/

class Solution {
public:
    vector<int> twoSum(vector<int>& numbers, int target) {
        int i = 0;
        int j = numbers.size() - 1;

        while (i < j) {
            int sum = numbers[i] + numbers[j];

            if (sum < target) {
                i++;
            }
            else if (sum > target) {
                j--;
            }
            else {
                return {i + 1, j + 1};
            }
        }

        return {};
    }
};
